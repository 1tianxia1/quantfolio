# ============================================================
# QuantFolio 环境变量示例（复制为 .env 后按需修改）
# ============================================================

# ---- 后端服务 ----
PORT=3001
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=quantfolio-dev-secret-change-me
# JWT 有效期（秒，默认 7 天）
JWT_EXPIRES_IN=604800

# ---- 数据库 ----
# SQLite 数据库文件路径（相对 server/ 目录或绝对路径）
DB_PATH=./data/quantfolio.db
# 数据源：sqlite（默认，读本地库）；http（预留，未实现时返回提示）
DATA_PROVIDER=sqlite

# ---- AI（服务端默认模型；用户可在「模型设置」页按账号覆盖）----
# 以下为系统级兜底配置：仅当用户未配置个人模型时生效。
# SiliconFlow API Key：https://siliconflow.cn/
AI_PROVIDER=siliconflow
AI_API_KEY=
# 模型名
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SiliconFlow OpenAI 兼容接口地址
AI_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
# AI 请求超时（毫秒）
AI_TIMEOUT_MS=20000

# ---- 预留 HTTP 数据源 ----
MARKET_API_BASE=

# ---- 种子数据 ----
# 种子行情文件路径（相对项目根目录）
SEED_DATA_PATH=../data/seed-market.json
