# TDX 桥接服务配置（重命名/复制为 .env 或直接以环境变量注入）
TDX_BRIDGE_PORT=5599

# 指向已安装 pytdx 的 python 解释器（建议用内置 venv）
# Windows 示例：
TDX_PYTHON=C:/Users/Y/.workbuddy/binaries/python/envs/default/Scripts/python.exe
# macOS/Linux 示例：
# TDX_PYTHON=/path/to/venv/bin/python

# 缓存刷新间隔（秒）。到期重新从通达信拉全量列表。
# 设为 0 则每次请求都实时重新拉取（最实时，但每次有一次连接开销）。
BRIDGE_CACHE_TTL=3600
